{
  "name": "Haokee Theme Light",
  "author": "Haokee",
  "dark": false,
  "editorScheme": "/haokee-light.xml",
  "colors": {
    "editorBackground": "#f5f5f5",
    "foreground": "#1c1c1e",
    "secondaryBackground": "#f5f5f7",
    "chromeBackground": "#ebebed",
    "inactiveTabBackground": "#f0f0f2",
    "popupBackground": "#ffffff",
    "selectionBackground": "#007AFF",
    "accent": "#007AFF",
    "border": "#d1d1d6",
    "secondaryForeground": "#515154"
  },
  "ui": {
    "Panel.background": "editorBackground",
    "Label.foreground": "foreground",
    "ToolWindow.background": "secondaryBackground",
    "ToolWindow.Header.background": "chromeBackground",
    "ToolWindow.Header.inactiveBackground": "secondaryBackground",
    "EditorTabs.background": "inactiveTabBackground",
    "EditorTabs.underlinedTabBackground": "editorBackground",
    "StatusBar.background": "chromeBackground",
    "Tree.background": "secondaryBackground",
    "Tree.foreground": "foreground",
    "Tree.selectionBackground": "selectionBackground",
    "Tree.selectionForeground": "#FFFFFF",
    "List.background": "secondaryBackground",
    "List.foreground": "foreground",
    "List.selectionBackground": "selectionBackground",
    "List.selectionForeground": "#FFFFFF",
    "Table.background": "editorBackground",
    "Table.foreground": "foreground",
    "Menu.background": "popupBackground",
    "Menu.foreground": "foreground",
    "PopupMenu.background": "popupBackground",
    "PopupMenu.foreground": "foreground",
    "TextField.background": "popupBackground",
    "TextField.foreground": "foreground",
    "TextArea.background": "editorBackground",
    "TextArea.foreground": "foreground",
    "ComboBox.background": "popupBackground",
    "ComboBox.foreground": "foreground",
    "Component.focusColor": "accent",
    "Component.borderColor": "border",
    "Separator.separatorColor": "border"
  }
}
